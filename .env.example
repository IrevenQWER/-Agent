APP_ENV=development
APP_API_HOST=127.0.0.1
APP_API_PORT=8000
APP_DATABASE_PATH=runtime/futureedu.db
APP_CASES_PATH=data/cases
APP_CHROMA_PATH=runtime/chroma
APP_REPORT_PROMPT_PATH=prompts/report_generation.yaml
APP_LEARNING_DATA_BACKEND=local
# 模型模式：deterministic（无需 API）、ollama（本机模型）或 openai（OpenAI 兼容 API）
APP_MODEL_PROVIDER=deterministic
APP_MODEL_NAME=demo
# Docker 访问本机 Ollama 使用 http://host.docker.internal:11434
# OpenAI 兼容 API 通常填写到 /v1，例如 https://api.openai.com/v1
APP_MODEL_BASE_URL=http://host.docker.internal:11434
# 仅 openai 模式必填；.env 已被 Git 忽略，不要把真实密钥写入 .env.example
APP_MODEL_API_KEY=
APP_MODEL_TIMEOUT_SECONDS=300
APP_MAX_REPORT_RETRIES=2
APP_MIN_CASE_RELEVANCE=0.35
APP_FINAL_CASE_COUNT=3
APP_PROFILE_RULES_VERSION=1.0.0
APP_PROMPT_VERSION=1.0.0
FUTUREEDU_API_URL=http://127.0.0.1:8000
FUTUREEDU_UI_HOST=127.0.0.1
FUTUREEDU_UI_PORT=7860
FUTUREEDU_UI_WAIT_SECONDS=300
FUTUREEDU_UI_POLL_INTERVAL_SECONDS=1
